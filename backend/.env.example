# Copy this file to .env and fill in real values before running the server.

NODE_ENV=development
PORT=4000

# Either set DATABASE_URL, or the individual PG* variables below.
# DATABASE_URL=postgresql://user:password@localhost:5432/linkroad_tms
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=linkroad_tms
PGSSLMODE=disable

# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-free single origin, or * for local development only.
CORS_ORIGIN=http://localhost:5173

BCRYPT_SALT_ROUNDS=12
